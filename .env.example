# =============================================================================
# Worldwide Shopio - Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in real values.
# NEVER commit real secrets. `.env*.local` is gitignored.
# All variables here are validated at runtime by `lib/env.ts`.
# =============================================================================

# --- Database ---------------------------------------------------------------
# Postgres connection string (e.g. Neon/Supabase pooled connection URL).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Authentication ---------------------------------------------------------
# Secret used to sign sessions/tokens. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-32+-char-random-string"

# Server-only secret used to sign customer dashboard sessions (minimum 32 chars).
CUSTOMER_SESSION_SECRET="replace-with-a-different-32+-char-random-string"

# --- Payments (Razorpay) ----------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"

# --- Application ------------------------------------------------------------
# Public base URL of the app. Exposed to the browser (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Media (Cloudinary) -----------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
